
{
  "entities": {
    "StartupProject": {
      "title": "StartupProject",
      "description": "A comprehensive record of a startup project venture.",
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "project_name": {
          "type": "string",
          "description": "The name of the startup project."
        },
        "idea_description": {
          "type": "string",
          "description": "Detailed description of the startup idea."
        },
        "startup_brain": {
          "type": "object",
          "description": "The shared intelligence layer for the startup.",
          "properties": {
            "startup_idea": { "type": "string" },
            "target_market": { "type": "string" },
            "problem_statement": { "type": "string" },
            "value_proposition": { "type": "string" },
            "revenue_model": { "type": "string" },
            "product_features": { "type": "string" },
            "marketing_strategy": { "type": "string" },
            "financial_forecast": { "type": "string" },
            "competitors": { "type": "string" },
            "tech_stack": { "type": "string" },
            "customer_segments": { "type": "string" },
            "pricing_strategy": { "type": "string" },
            "growth_strategy": { "type": "string" },
            "funding_stage": { "type": "string" }
          }
        },
        "startup_stage": { "type": "string" },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "userId": {
          "type": "string",
          "description": "The owner of this project."
        },
        "fullState": {
          "type": "object",
          "description": "Serialized full state of the startup context for reconstruction."
        }
      },
      "required": [
        "project_id",
        "project_name",
        "userId"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information about the registered founder.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "profile_photo": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "startup_projects": { 
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["user_id", "email"]
    },
    "ProjectAsset": {
      "title": "ProjectAsset",
      "description": "An asset (code, plan, etc.) generated by an executive persona.",
      "type": "object",
      "properties": {
        "asset_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "format": { "type": "string", "enum": ["code", "markdown", "text"] },
        "language": { "type": "string" },
        "role": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["asset_id", "title", "content"]
    }
  },
  "auth": {
    "providers": [
      "google.com",
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Founder profile document."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "StartupProject",
      "description": "The collection of projects owned by a user."
    },
    "/users/{userId}/projects/{projectId}/assets/{assetId}": {
      "schema": "ProjectAsset",
      "description": "Assets generated for a specific project."
    }
  }
}
